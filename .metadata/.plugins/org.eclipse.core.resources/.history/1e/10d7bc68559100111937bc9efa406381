package com.exam;

public class Song {
	
	private String title;
	private String artisit;
	private int year;
	private String country;
	private String onerName;
	
	public Song() { // 기본생성자
		this.onerName = "사용자";
	}
	
	public Song(String title, String artisit,String country, int year) {
		this.title = title;
		this.artisit = artisit;
		this.year = year;
		this.country = country;
	}
	

	public void show() {
		System.out.println(year+"년"+country+"의"+artisit+"가 부른"+title);
		System.out.println(this.onerName + "님 안녕하세요.");
	}
	
	public void playListName(String name) 
	{
		System.out.println(name+"의 플레이 리스트");
	}
	
	
	

}
