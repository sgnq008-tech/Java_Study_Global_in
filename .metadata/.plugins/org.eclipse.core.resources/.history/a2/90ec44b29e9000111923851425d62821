package com.exam;

public class Song {
	
	String title;
	String artisit;
	int year;
	String country;
	
	public Song(String title, String artisit, int year, String country) {
		this.title = title;
		this.artisit = artisit;
		this.year = year;
		this.country = country;
	}
	
	private void show() {
		System.out.println(year+"년"+country+"의"+artisit+"가 부른"+title);

	}
	
	
	
	

}
