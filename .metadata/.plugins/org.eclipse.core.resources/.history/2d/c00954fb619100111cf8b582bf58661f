package com.Gamu;

import java.util.*;
public class Player {
	
	Scanner sc = new Scanner(System.in);
	
	String name;
	int inwon;
	Record[] re;
	
	public void set() {
		do {
			System.out.print("인원수 입력 : ");
			inwon = sc.nextInt();				
		}while(inwon < 1 || inwon > 10);
	
		
		re = new Record[inwon];
	}
	
	
	public void input() {
		
		for(int i =0; i < inwon; i++) { 
			
			Player re[i] = new Player();
			System.out.print(i+1+"번쨰 이름 입력 : ");
			re[i].name= sc.next();
				
		}

}
}