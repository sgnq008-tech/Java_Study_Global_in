package com.objectEX;
/*
 * 인원 수를 입력받은 인원수 만큼
 * 이름, 각과목별 점수, 총점, 평균, 석차를 계산하는 클래스
 * 
 *  속성 : 인원수, 객체배열(Record 배열)
 *          inwon, Record[] re
 *            
 *  기능(매소드)정의
 *  인원수 입력기능 => set()
 *  데이터입력기능, 총점, 평균를 구하는 기능 => input()
 *  석차를 구하는 기능 => ranking()
 *  
 *  결과를 출력하는 기능 => disp()
 *  
 *   
 */

import java.util.Scanner;

public class Sungjuk {
	
	// 속성(변수 선언)
			int inwon;
			Record[] re;
			Scanner sc = new Scanner(System.in);
			
			/*Scanner sc;
			public Sungjuk {
			sc = new Scanner(System.in);
			}
			*
			*기능정의(메소드 정의)
			* 1. 인원수 입력기능
			*/
			public void set() {
				do {
					System.out.print("인원수 입력 : ");
					inwon = sc.nextInt();				
				}while(inwon < 1 || inwon > 10);
				// 인원수 만큼 객체 배열 선언
				
				re = new Record[inwon];
				// Record 클래스의 배열 변수를 inwon수 만큼 배열의 크기를 생성한 것이다.
				// 크기만 생성했지 인스턴스를 생성한 것은 아니다. 클래스가 몇개인지만 설정해둔 상태
			}
			
			// 2. 데이터 입력 및 계산{산 기능 구현
			public void input() {
				// 이름, 각과목별 점수입력, 총점, 평균을 계산하는 작업을 수행한다.
				String[] title = {"국어 :", "영어 :", "수학 :"};
				
				//인원수 만큼 데이터를 입력 받는다.
				for(int i =0; i < inwon; i++) { // i는 사람은 행을 의미함
					// 인원수 만큼 인스턴스를 생성해야함(객체를 생성)
					// *****(매우 중요함)
					
					re[i] = new Record();
					System.out.print(i+1+"번쨰 이름 입력 : ");
					re[i].name= sc.next();
					
					for(int j= 0; j < title.length; j++) { // j는 과목은 열을 의미함 
						System.out.print(title[j]);
						re[i].score[j] = sc.nextInt(); // 각 과목별 점수
						
						// 총점
						re[i].tot += re[i].score[j];
					}
					// 평균 계산
					re[i].avg = re[i].tot / (double)(title.length);
				}	
			}
			// 석차 구하기
			public void ranking() {
				int i, j;
				// 모든 학생의 석차를 1로 초기화
				
				
			}
			// 결과 출력
			public void disp() {
				System.out.println("이름  국어  수학  영어  총점  평균");
				for(int i = 0; i < inwon; i++) {
					// 이름 출력
					System.out.printf("%s", re[i].name);
					for(int j = 0; j < 3; j++) { // 각 과목별 점수
						System.out.printf("%5d",re[i].score[i]);
					}
					// 총점, 평균, 석차 출력
					System.out.printf("%7d", re[i].tot);
					System.out.printf("%10.2f", re[i].avg);
					System.out.println();
				}
			}
	

}
