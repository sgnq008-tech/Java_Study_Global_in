package com.objectEX;

public class CardExam {

	public static void main(String[] args) {
		// 클래스 변수(static 변수)는 객체생성 없이 (클래스명.변수)로 직접 사용이 가능함
		System.out.println("Card.width : "+Card.width);
		System.out.println("Card.height : "+Card.height);
		
		
		Card c1 = new Card(); // 객체를 생성
		c1.kind = "Heart";
		c1.number = 7;
		
		Card c2 = new Card();
		c2.kind = "Space";
		c2.number = 3;  // 인스턴스 변수
		
		System.out.println("c1은 "+ c1.kind+", "+c1.number+"이며 크기는 " +c1.width+"높이는" +c1.height+ "입니다." );
		
		


	}

}
