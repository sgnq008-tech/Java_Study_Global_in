package com.Gamu;

import java.util.*;
public class Player {
	
	Scanner sc = new Scanner(System.in);
	
	String name;
	int inwon;
	Player[] re;
	
	public void set() {
		System.out.println("끝말잇기 게임을 시작합니다. ..........");
		do {
			System.out.print("인원수 입력 : ");
			inwon = sc.nextInt();				
		}while(inwon < 1 || inwon > 10);
	
		
		re = new Player[inwon];
	}
	
	
	public void input() {
		
		for(int i =0; i < inwon; i++) { 
			
			re[i] = new Player();
			System.out.print(i+1+"참가자 이름 입력 : ");
			re[i].name= sc.next();
				
		}

}
}