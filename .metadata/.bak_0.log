        // long c =(long) a * 2000000L; 이런식으로 해도 밑에와 같은 값이나온다.
        long c =(long) a * b;
        System.out.println(c);
        
        long k = long(1_000_000 *  1_000_000;
        long m = 1_000_000 *  1_000_000L;
        
        System.out.println(k);
        System.out.println(m);

	}

}

