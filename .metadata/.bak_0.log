import java.util.*;
public class IfEX04 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n1, n2, n3;
		
		System.out.println("첫번쨰 수 :");
		n1 = sc.nextInt();
		System.out.println("두번쨰 수 :");
		n2 = sc.nextInt();
		System.out.println("세번쨰 수 :");
		n3 = sc.nextInt();
		
		int median = n1;// 처음 중간값을 n1으로 초기화 함

