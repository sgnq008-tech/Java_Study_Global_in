package ex;

/*문]
	사용자로부터 임의의 정수를 입력받아 1부터 입력받은 정수까지의
	전체의 합계, 짝수의 합계, 홀수의 합을 각각 출력하시오.
	단, 10단위로 출력하시오.
	
    정수 입력 : 59
    1 ~ 10까지의 전체의 합 :
    1 ~ 10까지의 짝수의 합 :
    1 ~ 10까지의 홀수의 합 :
    
    1 ~ 20까지의 전체의 합 :
    1 ~ 20까지의 짝수의 합 :
    1 ~ 20까지의 홀수의 합 :
    
    1 ~ 30까지의 짝수의 합 :
    1 ~ 30까지의 홀수의 합 :
    1 ~ 30까지의 전체의 합 :
    
    1 ~ 40까지의 짝수의 합 :
    1 ~ 40까지의 홀수의 합 :
    1 ~ 40까지의 전체의 합 :
    
    1 ~ 50까지의 짝수의 합 :
    1 ~ 50까지의 홀수의 합 :
    1 ~ 50까지의 전체의 합 :
    
    1 ~ 59까지의 짝수의 합 :
    1 ~ 59까지의 홀수의 합 :
    1 ~ 59까지의 전체의 합 :
*/
import java.util.Scanner;
public class ForEX07 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int n, result = 0, odd=0, even=0;
		// 전체의 합: result, 짝수의 합:even, 홀수의 합: odd
