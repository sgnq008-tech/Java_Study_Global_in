 *      5. boolean contains(Rectangle r) : 
 *              - 매개변수로 받은 r이 현 사각형 안에 있으면 true 리턴
 *              
 *        결과
 *        (2,2)에서 크기가 8x7인 사각형
 *        s의 면적은 36
 *        t는 r을 포함 합니다.
 */
public class Rectangle {
	
	int x;
	int y;
	int width;
	int height;
	
	public Rectangle(int x, int y, int width, int height) {
		this.x = x;
		this.y = y;
		this.width = width;
		this.height = height;
	}
	
	 public int square() 
	 return(x + y + width + height) square;
	 
